# --- CurrentCut environment ---
# Copy to services/agent/.env (backend) — never commit real keys.

# Google Gemini (Google AI Studio key). Missing -> Gemini mock mode.
GEMINI_API_KEY=
# Use Vertex AI instead of AI Studio key (optional)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Parallel Search API (hackathon Parallel track). Missing -> Parallel mock mode.
PARALLEL_API_KEY=
# Alternative to the above: path to a file containing the key (local dev only).
PARALLEL_API_KEY_FILE=

# Model routing — never hardcode model names in code.
GEMINI_VIDEO_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# Force mock even when keys exist (comma list: gemini,parallel,tts)
CURRENTCUT_FORCE_MOCK=

# Storage
CURRENTCUT_DATA_DIR=./data
# Phase 8: FIRESTORE_PROJECT / GCS_BUCKET

# Limits (cost control)
PARALLEL_MAX_SEARCHES_PER_RUN=20
GEMINI_MAX_CLIP_SECONDS=600
